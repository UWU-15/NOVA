<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05051A">

    <View
        android:id="@+id/Frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:2"
        android:layout_margin="24dp"
        android:background="@drawable/frame_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- с лёгкой пульсацией -->
    <ImageView
        android:id="@+id/explosion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/figure_1"
        android:scaleX="1.5"
        android:scaleY="1.5"
        app:layout_constraintStart_toStartOf="@id/Frame"
        app:layout_constraintEnd_toEndOf="@id/Frame"
        app:layout_constraintTop_toTopOf="@id/Frame"
        app:layout_constraintBottom_toBottomOf="@id/Frame"
        android:animation="@anim/pulse_slow" />

    <!-- с мягким fade + scale эффектом -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:src="@drawable/logo"
        android:layout_margin="24dp"
        app:layout_constraintEnd_toEndOf="@id/Frame"
        app:layout_constraintStart_toStartOf="@id/Frame"
        app:layout_constraintTop_toTopOf="@id/Frame"
        android:alpha="0.95"
        android:animation="@anim/logo_float" />

    <ProgressBar
        android:id="@+id/progressBarLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@id/Frame"
        app:layout_constraintEnd_toEndOf="@id/Frame"
        android:indeterminateTint="@color/white_text" />

</androidx.constraintlayout.widget.ConstraintLayout>
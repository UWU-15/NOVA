<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Градиентный фон -->
    <ImageView
        android:id="@+id/gradientBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/gradient_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Верхний левый PNG -->
    <ImageView
        android:id="@+id/linesTopLeft"
        android:layout_width="550dp"
        android:layout_height="500dp"
        android:layout_marginStart="-175dp"
        android:layout_marginTop="-130dp"
        android:alpha="1"
        android:src="@drawable/lines2_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/linesBottomRight"
        android:layout_width="550dp"
        android:layout_height="500dp"
        android:layout_marginEnd="-175dp"
        android:layout_marginBottom="-130dp"
        android:alpha="1"
        android:src="@drawable/lines2_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Фон для контента по центру -->
    <ImageView
        android:id="@+id/contentBackground"
        android:layout_width="350dp"
        android:layout_height="550dp"
        android:src="@drawable/back_window"
        android:scaleType="fitXY"
        android:alpha="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Заголовок -->

    <!-- Поле ввода Имени (расстояние 16dp от заголовка) -->

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:fontFamily="@font/zen_dots"
        android:text="Register"
        android:textColor="#0A0A20"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toTopOf="@id/contentBackground" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nameLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Name"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nameInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:fontFamily="@font/zen_dots"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:textColor="#0A0A20" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле ввода Email (расстояние 16dp от имени) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emailLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Email"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/nameLayout"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:fontFamily="@font/zen_dots"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#0A0A20" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле ввода Пароля с глазиком (расстояние 16dp от email) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Password"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:passwordToggleEnabled="true"
        app:passwordToggleTint="#0A0A20"
        app:layout_constraintTop_toBottomOf="@id/emailLayout"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:inputType="textPassword"
            android:fontFamily="@font/zen_dots"
            android:textColor="#0A0A20"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопка Create Account (расстояние 24dp от поля пароля) -->
    <Button
        android:id="@+id/createAccountButton"
        android:layout_width="200dp"
        android:layout_height="68dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/zen_dots"
        android:text="Create Account"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#A600FF"
        app:cornerRadius="4dp"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toBottomOf="@id/passwordLayout" />

    <!-- Do you have an account? Sign in (под кнопкой, расстояние 16dp) -->
    <TextView
        android:id="@+id/signInText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/zen_dots"
        android:text="Do you have an account? Sign in"
        android:textColor="#A600FF"
        android:textSize="14sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toBottomOf="@id/createAccountButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/gradientBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/gradient_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/linesTopLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="1.55"
        android:scaleY="1.2"
        android:layout_marginStart="-100dp"
        android:layout_marginTop="-250dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/lines2_2" />

    <ImageView
        android:id="@+id/linesTopRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleX="1.55"
        android:scaleY="1.2"
        android:layout_marginStart="100dp"
        android:layout_marginTop="250dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:src="@drawable/lines2_1" />

    <ImageView
        android:id="@+id/contentBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="9:16"
        android:layout_margin="30dp"
        android:src="@drawable/back_window"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/zen_dots"
        android:text="@string/sign_in"
        android:textColor="@color/dark_blue"
        android:textSize="35sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintTop_toTopOf="@id/contentBackground"
        app:layout_constraintBottom_toBottomOf="@id/contentBackground"
        app:layout_constraintVertical_bias="0.28"/>

    <com.google.android.material.textfield.TextInputLayout
    android:id="@+id/emailLayout"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginTop="16dp"
    android:hint="@string/email"
    app:boxBackgroundMode="outline"
    app:boxCornerRadius="4dp"
    app:layout_constraintTop_toBottomOf="@id/titleText"
    app:layout_constraintStart_toStartOf="@id/contentBackground"
    app:layout_constraintEnd_toEndOf="@id/contentBackground">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/dark_blue"
        android:padding="20dp"
        android:fontFamily="@font/zen_dots"
        android:inputType="textEmailAddress" />

</com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/passwordLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:hint="@string/password"
        app:boxBackgroundMode="outline"
        app:boxCornerRadius="4dp"
        app:passwordToggleEnabled="true"
        app:layout_constraintTop_toBottomOf="@id/emailLayout"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/dark_blue"
            android:padding="20dp"
            android:fontFamily="@font/zen_dots"
            android:inputType="textPassword" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/recoveryPasswordText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/zen_dots"
        android:padding="4dp"
        android:text="@string/recovery"
        android:textColor="@color/dark_blue"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@id/passwordLayout"
        app:layout_constraintTop_toBottomOf="@id/passwordLayout" />

    <Button
        android:id="@+id/actionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="90dp"
        android:layout_marginEnd="90dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/zen_dots"
        android:padding="15dp"
        android:text="@string/sign_in"
        android:textColor="@color/white_text"
        android:textSize="20sp"
        app:backgroundTint="@color/purple"
        app:cornerRadius="4dp"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toBottomOf="@id/recoveryPasswordText" />

    <TextView
        android:id="@+id/registerNowText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/zen_dots"
        android:text="@string/register_now"
        android:textColor="@color/purple"
        android:textSize="16sp"
        android:clickable="true"
        android:focusable="true"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toBottomOf="@id/actionButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
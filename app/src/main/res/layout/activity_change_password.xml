<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Градиентный фон -->
    <ImageView
        android:id="@+id/gradientBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/gradient_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Верхний левый PNG -->
    <ImageView
        android:id="@+id/linesTopLeft"
        android:layout_width="550dp"
        android:layout_height="500dp"
        android:layout_marginStart="-175dp"
        android:layout_marginTop="-130dp"
        android:alpha="1"
        android:src="@drawable/lines2_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/linesBottomRight"
        android:layout_width="550dp"
        android:layout_height="500dp"
        android:layout_marginEnd="-175dp"
        android:layout_marginBottom="-130dp"
        android:alpha="1"
        android:src="@drawable/lines2_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Фон для контента по центру -->
    <ImageView
        android:id="@+id/contentBackground"
        android:layout_width="350dp"
        android:layout_height="520dp"
        android:src="@drawable/back_window"
        android:scaleType="fitXY"
        android:alpha="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Заголовок -->

    <!-- Поле ввода Email (расстояние 16dp от заголовка) -->

    <TextView
        android:id="@+id/titleText"
        android:layout_width="329dp"
        android:layout_height="80dp"
        android:layout_marginTop="76dp"
        android:fontFamily="@font/zen_dots"
        android:gravity="center"
        android:text="Change Password"
        android:textColor="#0A0A20"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toTopOf="@id/contentBackground" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/emailLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:hint="Email"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:fontFamily="@font/zen_dots"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#0A0A20" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле ввода Нового Пароля (расстояние 16dp от email) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/newPasswordLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="New Password"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/emailLayout"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/newPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:inputType="textPassword"
            android:fontFamily="@font/zen_dots"
            android:textColor="#0A0A20"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле ввода Подтверждения Пароля (расстояние 16dp от нового пароля) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/confirmPasswordLayout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Repeat Password"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#0A0A20"
        app:boxCornerRadiusTopStart="4dp"
        app:boxCornerRadiusTopEnd="4dp"
        app:boxCornerRadiusBottomStart="4dp"
        app:boxCornerRadiusBottomEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/newPasswordLayout"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirmPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:inputType="textPassword"
            android:fontFamily="@font/zen_dots"
            android:textColor="#0A0A20"
            android:padding="12dp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопка Change Password (расстояние 24dp от подтверждения пароля) -->
    <Button
        android:id="@+id/changePasswordButton"
        android:layout_width="200dp"
        android:layout_height="68dp"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/zen_dots"
        android:text="Change password"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        app:backgroundTint="#A600FF"
        app:cornerRadius="4dp"
        app:layout_constraintEnd_toEndOf="@id/contentBackground"
        app:layout_constraintStart_toStartOf="@id/contentBackground"
        app:layout_constraintTop_toBottomOf="@id/confirmPasswordLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>
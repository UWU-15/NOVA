<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NOVA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#A600FF</item>
        <item name="colorPrimaryVariant">#7D00CC</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#A600FF</item>
        <item name="colorSecondaryVariant">#7D00CC</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">#0A0A20</item>
        <item name="android:windowBackground">@color/black</item>
    </style>
    <style name="ZenChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textAppearance">@style/ZenChipText</item>
        <item name="android:textColor">@color/white</item>

        <item name="chipMinHeight">60dp</item>
        <item name="android:minWidth">0dp</item>

        <item name="chipStartPadding">20dp</item>
        <item name="chipEndPadding">20dp</item>

        <item name="chipBackgroundColor">@color/dark_blue</item>
        <item name="chipStrokeColor">@color/purple</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipCornerRadius">15dp</item>
        <item name="closeIconVisible">false</item>
    </style>

    <style name="ZenChipText" parent="TextAppearance.MaterialComponents.Chip">
        <item name="android:fontFamily">@font/zen_dots</item>
        <item name="fontFamily">@font/zen_dots</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="RoundedSquare">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>